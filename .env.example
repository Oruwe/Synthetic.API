# --- Ports / hosts ---
PORTAL_BASE_URL=http://mock_portal:5000
QDRANT_URL=http://qdrant:6333
RUN_STORE_DIR=/data/runs

# --- Lyzr ---
# TODO(verify): exact env var name(s) and auth scheme per the hackathon starter kit.
LYZR_API_KEY=
LYZR_ENABLED=false

# --- LLM fallback (used by lyzr_wrapper if LYZR_ENABLED=false or the Lyzr call fails) ---
# Routed through OpenRouter (https://openrouter.ai/keys) to an open-weight
# model, on purpose -- keeps the project's own "brain" open-source too, not
# just the code. Default is DeepSeek V3 (MIT-licensed, benchmarks near
# closed frontier models on general reasoning/writing). Swap the model with
# no code change; check https://openrouter.ai/rankings before a demo, since
# a better open model may have shipped since. Add ":free" to the model id
# for OpenRouter's free tier, e.g. deepseek/deepseek-chat-v3.1:free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1

# --- Web-Researcher: search + screenshot + open-weight vision model ---
# Same OPENROUTER_API_KEY above is reused for the vision call. Qwen2.5-VL
# is Apache-2.0 and, as of writing, a top open-weight vision-language
# model for screenshot/document understanding -- check
# https://openrouter.ai/rankings before a demo for anything newer.
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct
RESEARCH_MAX_RESULTS=5
# Cosine similarity cutoff: candidates scoring below this against the
# original query are deleted from Qdrant during curate_knowledge, not just
# hidden -- "the majority junk is deleted."
RESEARCH_RELEVANCE_THRESHOLD=0.35
SCREENSHOT_DIR=/data/screenshots

# --- Omi ---
# TODO(verify): exact webhook auth header/secret per the hackathon starter kit.
OMI_WEBHOOK_SECRET=

# --- Langfuse ---
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true

# --- Mock portal auth (demo credentials only, not real secrets) ---
PORTAL_USERNAME=admin
PORTAL_PASSWORD=admin123

# --- Circuit breaker / retries ---
# 2, not a bigger number: the standard shipping-portal plan only has 3
# nodes, so a higher threshold could never actually trip on it.
DAG_CIRCUIT_BREAKER_THRESHOLD=2
