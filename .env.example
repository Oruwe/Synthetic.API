# --- Ports / hosts ---
PORTAL_BASE_URL=http://mock_portal:5000
QDRANT_URL=http://qdrant:6333
RUN_STORE_DIR=/data/runs

# --- Lyzr ---
# TODO(verify): exact env var name(s) and auth scheme per the hackathon starter kit.
LYZR_API_KEY=
LYZR_ENABLED=false

# --- LLM fallback (used by lyzr_wrapper if LYZR_ENABLED=false or the Lyzr call fails) ---
# Routed through OpenRouter (https://openrouter.ai/keys) to an open-weight
# model, on purpose -- keeps the project's own "brain" open-source too, not
# just the code. Default is DeepSeek V3 (MIT-licensed, benchmarks near
# closed frontier models on general reasoning/writing). Swap the model with
# no code change; check https://openrouter.ai/rankings before a demo, since
# a better open model may have shipped since. Add ":free" to the model id
# for OpenRouter's free tier, e.g. deepseek/deepseek-chat-v3.1:free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1

# --- Search + fetch + chunk + semantic retrieval (the LIVE research path) ---
# Get a key at https://tavily.com. Without one, search_wrapper.search()
# logs a warning and returns no candidate URLs -- the DAG still runs and
# the Synthesizer answers with "no sources found" rather than failing.
TAVILY_API_KEY=
RESEARCH_MAX_RESULTS=5
# Applied to BOTH the fast (HTTP) and Playwright-fallback fetch per URL.
PAGE_FETCH_TIMEOUT_SECONDS=9
# How many top-scoring chunks the Synthesizer retrieves per run to draft
# its answer from.
RESEARCH_TOP_K=5
QDRANT_PAGES_COLLECTION=web_pages

# --- Retired from live routing, kept only for the dormant DDG+vision
# research pipeline (agents/web_navigator/searcher.py, screenshotter.py,
# research_handlers.py, common/vision_wrapper.py -- still present, still
# tested, just not imported by orchestrator/main.py anymore) ---
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct
RESEARCH_RELEVANCE_THRESHOLD=0.35
SCREENSHOT_DIR=/data/screenshots

# --- Omi ---
# TODO(verify): exact webhook auth header/secret per the hackathon starter kit.
OMI_WEBHOOK_SECRET=

# --- Langfuse ---
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true

# --- Mock portal auth (demo credentials only, not real secrets) ---
# Retired from live routing (see planner.py) -- kept only as an offline
# fixture target for the dormant shipping-portal pipeline's own tests.
PORTAL_USERNAME=admin
PORTAL_PASSWORD=admin123

# --- Circuit breaker / retries ---
# 2, not a bigger number: the live plan only has 2 nodes (fetch_pages,
# embed_pages), so a higher threshold could never actually trip on it.
DAG_CIRCUIT_BREAKER_THRESHOLD=2
